# ============ 签名密钥：绝对不能提交 ============
# 仓库是公开的。密钥和口令一旦泄露，任何人都能签一个假 App 覆盖安装到你手机上。
# 这两个文件请自己另存一份到网盘，也请不要删掉下面这两行规则。
android/jizhang.keystore
android/keystore.properties

# ============ 依赖和构建产物 ============
node_modules/
dist/

# 安卓构建产物
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/

# 每台机器自己的配置（安卓 SDK 路径）
android/local.properties

# 每次 npx cap sync 都会重新生成
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/res/xml/config.xml

# android 目录下编译出来的 APK
android/**/*.apk

# ============ 走查工具的临时输出 ============
tools/shots/
tools/report*.txt

# ============ 本地工作笔记：不公开 ============
# 这里存的是开发过程中的备忘录（本机路径、待办、迭代记录等），
# 和 App 本身无关，没必要进公开仓库。
.workbuddy/

# ============ 系统杂物 ============
.DS_Store
Thumbs.db
*.log

# Vite 转译 vite.config.js 时写的临时文件，正常跑完会自动删掉。
# 但沙箱的「批量删除守卫」在一轮对话里删够 50 个文件后就会开始拦删除
# （走查脚本每跑一次就要清空 tools/shots/ 里 26 张截图），
# 这些临时文件于是会留在仓库里 —— 实测漏进来过一次，所以加条规则兜住。
vite.config.js.timestamp-*
